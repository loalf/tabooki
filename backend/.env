# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/tabooki?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> tabooki/extraction ###
# Amazon Bedrock, used to extract recipes. Put the API key in .env.local (never commit it):
#   AWS_BEARER_TOKEN_BEDROCK=ABSK...
# Check the setup and see which models your key can use: make console c=app:bedrock:check
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-west-1
# Reads captions, transcripts and pages (cheap, fast, good at JSON).
BEDROCK_TEXT_MODEL=eu.anthropic.claude-haiku-5-5
# Let the model think before answering (Claude models). Off is faster and
# uses far fewer output tokens; on may read messy captions better. Compare with app:extract.
EXTRACTION_THINKING=1
# Optional: cookies.txt of a logged-in browser, for Instagram posts yt-dlp can't read anonymously.
# In dev, save it as backend/.ytdlp-cookies.txt (gitignored) and set /app/.ytdlp-cookies.txt;
# not under var/, which the containers keep in their own volume.
YTDLP_COOKIES_FILE=
# OpenRouter, for speech to text (Whisper) when a video has to be watched (the caption isn't enough
# and it has no subtitles, like Instagram and TikTok). Its stills go to BEDROCK_TEXT_MODEL.
# Put the API key in .env.local (never commit it): OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# Search by meaning: recipes and queries as vectors (multilingual; 512 dimensions, see App\Llm\Embedding).
# Cohere Embed v4 through the EU profile; Titan (amazon.titan-embed-text-v2:0) also works but finds
# less. After changing it, run app:embed, and check App\Search\RecipeSearch's score thresholds.
BEDROCK_EMBEDDING_MODEL=eu.cohere.embed-v4:0
###< tabooki/extraction ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# The issuer of the JWTs, must be trusted by the hub (MERCURE_TRUSTED_ISSUERS)
MERCURE_JWT_ISSUER=https://localhost
###< symfony/mercure-bundle ###

###> symfony/mailer ###
# Password reset emails. null://null discards them (fine for development); see docs/DEPLOY.md.
MAILER_DSN=null://null
MAILER_FROM="Tabooki <no-reply@tabooki.xyz>"
###< symfony/mailer ###
